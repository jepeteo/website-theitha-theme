# Public site (used for reference if needed)
PUBLIC_SITE_ORIGIN=https://www.theitha.com

# Ghost internal origin (REAL Ghost host)
GHOST_ORIGIN=https://investment-trading-hub-academy.ghost.io

# Ghost Admin API
GHOST_ADMIN_API_URL=https://investment-trading-hub-academy.ghost.io/ghost/api/admin/
GHOST_ADMIN_API_KEY=YOUR_ADMIN_KEY
# Comma-separated emails that should always be treated as paid (e.g. owners/admins)
ADMIN_BYPASS_EMAILS=owner@example.com,admin@example.com

# Database
DATABASE_URL=postgres://...

# Twelve Data (price feed for live signal tracking)
TWELVE_DATA_API_KEY=YOUR_TWELVE_DATA_KEY

# Admin panel password (for admin.theitha.com)
ADMIN_PASSWORD=YOUR_ADMIN_PASSWORD

# Vercel cron secret — set in Vercel env vars, protects /api/cron/* endpoints
CRON_SECRET=YOUR_CRON_SECRET

# Optional
JWKS_CACHE_TTL=3600
MEMBER_CACHE_TTL=300
SUMMARY_CACHE_TTL=30

<!DOCTYPE html>
<html lang="{{@site.locale}}">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{{meta_title}}</title>
  <script>
    (function () {
      try {
        var storedTheme = localStorage.getItem("theitha-theme");
        var allowedThemes = ["light", "dark", "warm", "forest", "sun"];
        var theme = allowedThemes.indexOf(storedTheme) > -1 ? storedTheme : "dark";
        document.documentElement.setAttribute("data-theme", theme);
      } catch (_error) {
        document.documentElement.setAttribute("data-theme", "dark");
      }
    })();
  </script>
  {{ghost_head}}
  <link rel="stylesheet" href="{{asset "css/screen.css"}}" />
  <script>
    window.__ACCESS__ = {
      member: {{#if @member}}true{{else}}false{{/if}},
      paid: {{#if @member.paid}}true{{else}}false{{/if}}
    };
  </script>
</head>
<body class="site min-h-screen flex flex-col">
  {{> header}}
  <main class="site-main flex-1">
    <div class="container">
      {{{body}}}
    </div>
  </main>
  {{> footer}}
  {{> scripts}}
  {{ghost_foot}}
</body>
</html>

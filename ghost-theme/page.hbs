{{!< default}}

<div data-view="page-detail" class="py-10">
  <article class="flex flex-col gap-4 max-w-3xl">

    {{#if @page.show_title_and_feature_image}}
      <header class="mb-6">
        <h1>{{title}}</h1>

        {{#if feature_image}}
          <img src="{{feature_image}}" alt="{{title}}" />
        {{/if}}
      </header>
    {{/if}}

    <section class="prose prose-invert max-w-none">
      {{content}}
    </section>

  </article>
</div>

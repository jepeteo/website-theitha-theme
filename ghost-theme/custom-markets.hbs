{{!< default}}

<div data-view="markets" class="py-8 flex flex-col gap-8">
  {{!-- Page header --}}
  <section aria-labelledby="markets-title" class="flex flex-col items-center text-center gap-3">
    <h1 id="markets-title" class="text-3xl md:text-4xl font-bold tracking-tight">
      Markets <span class="text-primary">Dashboard</span>
    </h1>
    <p class="text-muted text-base max-w-lg">Live charts, quotes, and economic calendar.</p>
  </section>

  {{!-- 1) Market Overview --}}
  <section data-container="markets-overview" class="flex flex-col gap-3">
    <div class="widget-card">
      <div class="widget-card__header">
        <h2 class="text-base font-semibold text-text">Market Overview</h2>
        <span class="text-caption">Real-time quotes</span>
      </div>
      <div class="widget-card__body widget-card__body--market-overview">
        {{> market-overview}}
      </div>
    </div>
  </section>

  {{!-- 2) Economic Calendar --}}
  <section data-container="markets-calendar" class="flex flex-col gap-3">
    <div class="widget-card">
      <div class="widget-card__header">
        <h2 class="text-base font-semibold text-text">Economic Calendar</h2>
        <span class="text-caption">Upcoming events</span>
      </div>
      <div class="widget-card__body" style="min-height: 500px;">
        <div id="tv-economic-calendar" class="w-full"></div>
      </div>
    </div>
  </section>

  {{!-- 3) Forex Heatmap --}}
  <section data-container="markets-forex-heatmap" class="flex flex-col gap-3">
    <div class="widget-card">
      <div class="widget-card__header">
        <h2 class="text-base font-semibold text-text">Forex Heatmap</h2>
        <span class="text-caption">Currency strength map</span>
      </div>
      <div class="widget-card__body" style="min-height: 420px;">
        <div id="tv-forex-heatmap" class="w-full"></div>
      </div>
    </div>
  </section>

  {{!-- 4) Forex Cross Rates --}}
  <section data-container="markets-forex-cross-rates" class="flex flex-col gap-3">
    <div class="widget-card">
      <div class="widget-card__header">
        <h2 class="text-base font-semibold text-text">Forex Cross Rates</h2>
        <span class="text-caption">Live cross-rate matrix</span>
      </div>
      <div class="widget-card__body" style="min-height: 420px;">
        <div id="tv-forex-cross-rates" class="w-full"></div>
      </div>
    </div>
  </section>

  {{!-- 5) Screener (Major / Minor / Exotics) --}}
  <section data-container="markets-screener" class="flex flex-col gap-4">
    <div class="grid grid-cols-1 xl:grid-cols-3 gap-4">
      <div class="widget-card">
        <div class="widget-card__header">
          <h2 class="text-base font-semibold text-text">Screener — Major</h2>
          <span class="text-caption">Forex majors</span>
        </div>
        <div class="widget-card__body" style="min-height: 500px;">
          <div id="tv-forex-screener-major" class="w-full"></div>
        </div>
      </div>

      <div class="widget-card">
        <div class="widget-card__header">
          <h2 class="text-base font-semibold text-text">Screener — Minor</h2>
          <span class="text-caption">Forex minors</span>
        </div>
        <div class="widget-card__body" style="min-height: 500px;">
          <div id="tv-forex-screener-minor" class="w-full"></div>
        </div>
      </div>

      <div class="widget-card">
        <div class="widget-card__header">
          <h2 class="text-base font-semibold text-text">Screener — Exotics</h2>
          <span class="text-caption">Forex exotics</span>
        </div>
        <div class="widget-card__body" style="min-height: 500px;">
          <div id="tv-forex-screener-exotic" class="w-full"></div>
        </div>
      </div>
    </div>
  </section>

  {{!-- 6) Economic Map --}}
  <section data-container="markets-economic-map" class="flex flex-col gap-3">
    <div class="widget-card">
      <div class="widget-card__header">
        <h2 class="text-base font-semibold text-text">Economic Map</h2>
        <span class="text-caption">Global macro map</span>
      </div>
      <div class="widget-card__body" style="min-height: 520px;">
        <div id="tv-economic-map" class="w-full h-full"></div>
      </div>
    </div>
  </section>

  {{!-- 7) Stock Heatmap --}}
  <section data-container="markets-stock-heatmap" class="flex flex-col gap-3">
    <div class="widget-card">
      <div class="widget-card__header">
        <h2 class="text-base font-semibold text-text">Stock Heatmap</h2>
        <span class="text-caption">Macro stock view</span>
      </div>
      <div class="widget-card__body" style="min-height: 520px;">
        <div id="tv-stock-heatmap" class="w-full h-full"></div>
      </div>
    </div>
  </section>

  {{!-- 8) ETF Heatmap --}}
  <section data-container="markets-etf-heatmap" class="flex flex-col gap-3">
    <div class="widget-card">
      <div class="widget-card__header">
        <h2 class="text-base font-semibold text-text">ETF Heatmap</h2>
        <span class="text-caption">ETF performance map</span>
      </div>
      <div class="widget-card__body" style="min-height: 520px;">
        <div id="tv-etf-heatmap" class="w-full h-full"></div>
      </div>
    </div>
  </section>
</div>

{{!< default}}

<div data-view="tag" class="py-10 grid grid-cols-1 lg:grid-cols-12 gap-8">
  <section class="lg:col-span-8 flex flex-col gap-5" aria-labelledby="tag-title">
    <header class="flex flex-col gap-2">
      <span class="text-primary text-xs font-semibold uppercase tracking-widest">Tag</span>
      <h1 id="tag-title" class="section-title">{{tag.name}}</h1>
      {{#if tag.description}}
        <p class="text-muted">{{tag.description}}</p>
      {{/if}}
    </header>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
      {{#foreach posts}}
        {{> blog-card}}
      {{/foreach}}
    </div>
  </section>

  <aside class="lg:col-span-4" aria-label="Sidebar">
    {{> sidebar}}
  </aside>
</div>

{{!< default}}

<div data-view="post-detail" class="py-8 grid grid-cols-1 lg:grid-cols-12 gap-8 post-layout">
  {{!-- Main article --}}
  <article class="lg:col-span-8 flex flex-col gap-6 post-article" data-container="post-content" aria-label="Post content">
    {{#post}}
      <header class="flex flex-col gap-4 post-header">
        {{#if primary_tag}}
          <a href="{{primary_tag.url}}" class="text-primary text-xs font-semibold uppercase tracking-widest hover:text-accent-hover transition-colors w-fit">{{primary_tag.name}}</a>
        {{/if}}
        <h1 class="text-3xl md:text-4xl font-bold tracking-tight leading-tight post-title">{{title}}</h1>
        <div class="post-meta-row">
          <div class="flex items-center gap-3 text-caption post-meta">
            {{#if primary_author.profile_image}}
              <img src="{{primary_author.profile_image}}" alt="{{primary_author.name}}" class="w-9 h-9 rounded-full border border-border" />
            {{/if}}
            <div class="flex flex-col">
              <span class="text-text text-sm font-medium">{{primary_author.name}}</span>
              <div class="flex items-center gap-2 text-xs">
                <time datetime="{{date format='YYYY-MM-DD'}}">{{date format="MMM D, YYYY"}}</time>
                {{#if reading_time}}
                  <span class="text-border">&middot;</span>
                  <span>{{reading_time}} min read</span>
                {{/if}}
              </div>
            </div>
          </div>

          <section class="post-share post-share--inline" aria-label="Share this post" data-post-share data-share-title="{{title}}" data-share-url="{{url absolute='true'}}">
            <button type="button" class="post-share__trigger" data-share-toggle aria-expanded="false" aria-haspopup="true">
              <span class="post-share__trigger-icon">↗</span>
              <span>Share</span>
            </button>

            <div class="post-share__panel hidden" data-share-panel>
              <div class="post-share__group post-share__group--primary">
                <a class="post-share__item" data-share-platform="x" href="#" target="_blank" rel="noopener noreferrer"><span class="post-share__icon">𝕏</span><span>Share on X</span></a>
                <a class="post-share__item" data-share-platform="facebook" href="#" target="_blank" rel="noopener noreferrer"><span class="post-share__icon">f</span><span>Share on Facebook</span></a>
                <a class="post-share__item" data-share-platform="linkedin" href="#" target="_blank" rel="noopener noreferrer"><span class="post-share__icon">in</span><span>Share on LinkedIn</span></a>
                <a class="post-share__item" data-share-platform="pinterest" href="#" target="_blank" rel="noopener noreferrer"><span class="post-share__icon">p</span><span>Share on Pinterest</span></a>
                <a class="post-share__item" data-share-platform="email" href="#"><span class="post-share__icon">✉</span><span>Share via Email</span></a>
                <button type="button" class="post-share__item" data-copy-link><span class="post-share__icon">🔗</span><span>Copy link</span></button>
              </div>
            </div>
          </section>
        </div>
      </header>

      {{#if feature_image}}
        <figure class="-mx-5 md:mx-0 overflow-hidden rounded-none md:rounded-xl">
          {{#if feature_image_alt}}
            <img src="{{feature_image}}" alt="{{feature_image_alt}}" class="w-full max-h-96 object-cover" loading="lazy" />
          {{else}}
            <img src="{{feature_image}}" alt="{{title}}" class="w-full max-h-96 object-cover" loading="lazy" />
          {{/if}}
          {{#if feature_image_caption}}
            <figcaption class="text-caption text-xs text-center mt-2 px-5 md:px-0">{{feature_image_caption}}</figcaption>
          {{/if}}
        </figure>
      {{/if}}

      <section class="prose-custom prose-haas max-w-none">
        {{content}}
      </section>

      {{!-- Tags footer --}}
      {{#if tags}}
        <footer class="flex flex-wrap gap-2 pt-4 border-t border-border">
          {{#foreach tags}}
            <a href="{{url}}" class="text-xs px-3 py-1 rounded-full bg-surface-2 border border-border text-muted hover:text-text hover:border-primary transition-colors">{{name}}</a>
          {{/foreach}}
        </footer>
      {{/if}}

      <section class="post-share post-share--footer" aria-label="Share this post" data-post-share data-share-title="{{title}}" data-share-url="{{url absolute='true'}}">
        <button type="button" class="post-share__trigger" data-share-toggle aria-expanded="false" aria-haspopup="true">
          <span class="post-share__trigger-icon">↗</span>
          <span>Share</span>
        </button>

        <div class="post-share__panel hidden" data-share-panel>
          <div class="post-share__group post-share__group--primary">
            <a class="post-share__item" data-share-platform="x" href="#" target="_blank" rel="noopener noreferrer"><span class="post-share__icon">𝕏</span><span>Share on X</span></a>
            <a class="post-share__item" data-share-platform="facebook" href="#" target="_blank" rel="noopener noreferrer"><span class="post-share__icon">f</span><span>Share on Facebook</span></a>
            <a class="post-share__item" data-share-platform="linkedin" href="#" target="_blank" rel="noopener noreferrer"><span class="post-share__icon">in</span><span>Share on LinkedIn</span></a>
            <a class="post-share__item" data-share-platform="pinterest" href="#" target="_blank" rel="noopener noreferrer"><span class="post-share__icon">p</span><span>Share on Pinterest</span></a>
            <a class="post-share__item" data-share-platform="email" href="#"><span class="post-share__icon">✉</span><span>Share via Email</span></a>
            <button type="button" class="post-share__item" data-copy-link><span class="post-share__icon">🔗</span><span>Copy link</span></button>
          </div>
        </div>
      </section>
    {{/post}}
  </article>

  {{!-- Sidebar --}}
  <aside class="lg:col-span-4" data-container="post-sidebar" aria-label="Post sidebar">
    {{> sidebar}}
  </aside>
</div>

{
    "name": "theitha-ghost-theme",
    "version": "0.1.0",
    "private": true,
    "description": "Ghost theme scaffold for theitha.com",
    "keywords": ["ghost-theme"],
    "author": {
        "name": "Theitha",
        "email": "dev@theitha.com"
    },
    "config": {
        "posts_per_page": 12,
        "card_assets": true
    },
    "scripts": {
        "check": "echo Theme scaffold ready",
        "dev": "tailwindcss -i ./assets/css/tailwind.css -o ./assets/css/screen.css --watch",
        "build": "tailwindcss -i ./assets/css/tailwind.css -o ./assets/css/screen.css --minify"
    },
    "devDependencies": {
        "autoprefixer": "^10.4.20",
        "postcss": "^8.4.49",
        "tailwindcss": "^4.3.1"
    }
}
{{!< default}}

<div data-view="blog-index" class="py-10 grid grid-cols-1 lg:grid-cols-12 gap-8">
  <section class="lg:col-span-8 flex flex-col gap-5" data-container="blog-index-list" aria-labelledby="blog-index-title">
    <h1 id="blog-index-title" class="section-title">Blog</h1>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
      {{#foreach posts}}
        {{> blog-card}}
      {{/foreach}}
    </div>
  </section>

  <aside class="lg:col-span-4" data-container="blog-sidebar" aria-label="Sidebar">
    {{> sidebar}}
  </aside>
</div>

{{pagination}}

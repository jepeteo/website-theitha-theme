<footer data-partial="footer" class="site-footer" role="contentinfo" itemscope itemtype="https://schema.org/WPFooter">
  <div class="container">
    {{!-- Main footer grid --}}
    <div class="footer-grid">
      {{!-- Brand column --}}
      <div class="footer-brand">
        <a href="{{@site.url}}" class="footer-logo" aria-label="{{@site.title}} Home">
          {{#if @site.logo}}
            <img src="{{@site.logo}}" alt="{{@site.title}}" loading="lazy" width="120" height="32" />
          {{else}}
            <span class="footer-logo__text">{{@site.title}}</span>
          {{/if}}
        </a>
        <p class="footer-tagline">Premium trading signals, real-time market data &amp; expert analysis for active traders.</p>
        {{#if @site.facebook}}
          <div class="footer-social">
            <a href="{{facebook_url}}" title="Facebook" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M9.101 23.691v-7.98H6.627v-3.667h2.474v-1.58c0-4.085 1.848-5.978 5.858-5.978.401 0 1.09.044 1.613.115v3.146a10 10 0 0 0-.916-.036c-1.3 0-1.801.493-1.801 1.776v2.557h4.571l-.786 3.668h-3.785v7.98C18.265 22.981 22 18.012 22 12.198 22 5.768 17.18 2 12 2S2 5.768 2 12.198c0 4.756 2.725 8.986 6.71 10.87z"/></svg>
            </a>
            {{#if @site.twitter}}
              <a href="{{twitter_url}}" title="X (Twitter)" target="_blank" rel="noopener noreferrer" aria-label="X (Twitter)">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
              </a>
            {{/if}}
          </div>
        {{/if}}
      </div>

      {{!-- Navigation column --}}
      <div class="footer-col">
        <h3 class="footer-heading">Navigate</h3>
        <nav aria-label="Footer navigation">
          <ul class="footer-links">
            <li><a href="/">Home</a></li>
            <li><a href="/markets/">Markets</a></li>
            <li><a href="/signals/">Signals</a></li>
            <li><a href="https://christosmentis.substack.com/" target="_blank" rel="noopener noreferrer">Substack</a></li>
            <li><a href="#/portal/signup" data-portal="signup">Subscribe</a></li>
          </ul>
        </nav>
      </div>

      {{!-- Resources / Explore column --}}
      <div class="footer-col">
        <h3 class="footer-heading">Resources</h3>
        <nav aria-label="Resources">
          <ul class="footer-links">
            {{#foreach navigation}}
              <li><a href="{{url}}">{{label}}</a></li>
            {{/foreach}}
          </ul>
        </nav>
      </div>

      {{!-- Legal column (secondary menu) --}}
      <div class="footer-col">
        <h3 class="footer-heading">Legal</h3>
        <nav aria-label="Legal">
          <ul class="footer-links">
            <li><a href="https://www.theitha.com/disclaimer/">Disclaimer</a></li>
            <li><a href="https://www.theitha.com/risk-warning/">Risk Warning</a></li>
            <li><a href="https://www.theitha.com/terms-of-use/">Terms of Use</a></li>
            <li><a href="https://www.theitha.com/disclaimers-legal/">Disclaimers &amp; Legal</a></li>
            <li><a href="https://www.theitha.com/privacy-policy/">Privacy Policy</a></li>
          </ul>
        </nav>
      </div>
    </div>

    {{!-- Risk disclaimer --}}
    <div class="footer-risk">
      <p><strong>Risk Disclaimer:</strong> Trading financial instruments carries a high level of risk and may not be suitable for all investors. Past performance is not indicative of future results.</p>
    </div>

    {{!-- Bottom bar --}}
    <div class="footer-bottom">
      <span>&copy; {{date format="YYYY"}} {{@site.title}}. All rights reserved.</span>
      <a href="https://www.mtxstudio.com/" target="_blank" rel="noopener noreferrer" class="footer-credit">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19l7-7 3 3-7 7-3-3z"/><path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"/><path d="M2 2l7.586 7.586"/><circle cx="11" cy="11" r="2"/></svg>
        Made by MTX Studio
      </a>
    </div>
  </div>
</footer>

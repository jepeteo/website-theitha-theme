<section data-partial="signals-section" class="flex flex-col gap-4">
  {{!-- Summary stats bar --}}
  <div data-signals-summary class="signals-hero__stats" style="justify-content: center;">
    {{!-- Skeleton placeholder while loading --}}
    <div class="signals-stat" data-signals-skeleton>
      <span class="signals-stat__value skeleton-bar w-8 h-6">&nbsp;</span>
      <span class="signals-stat__label">Active</span>
    </div>
    <div class="signals-stat" data-signals-skeleton>
      <span class="signals-stat__value skeleton-bar w-8 h-6">&nbsp;</span>
      <span class="signals-stat__label">Winners</span>
    </div>
    <div class="signals-stat" data-signals-skeleton>
      <span class="signals-stat__value skeleton-bar w-8 h-6">&nbsp;</span>
      <span class="signals-stat__label">Total</span>
    </div>
  </div>

  {{!-- Signal cards grid with skeleton placeholders --}}
  <div data-signals-list class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
    <div class="card-signal skeleton-card" data-signals-skeleton>
      <div class="flex items-center justify-between mb-3">
        <div class="flex items-center gap-2">
          <span class="skeleton-bar w-8 h-8 rounded-full"></span>
          <span class="skeleton-bar w-20 h-4"></span>
        </div>
        <span class="skeleton-bar w-16 h-5 rounded-full"></span>
      </div>
      <div class="grid grid-cols-2 gap-2">
        <span class="skeleton-bar w-full h-12 rounded-lg"></span>
        <span class="skeleton-bar w-full h-12 rounded-lg"></span>
        <span class="skeleton-bar w-full h-12 rounded-lg"></span>
        <span class="skeleton-bar w-full h-12 rounded-lg"></span>
      </div>
    </div>
    <div class="card-signal skeleton-card hidden md:block" data-signals-skeleton>
      <div class="flex items-center justify-between mb-3">
        <div class="flex items-center gap-2">
          <span class="skeleton-bar w-8 h-8 rounded-full"></span>
          <span class="skeleton-bar w-20 h-4"></span>
        </div>
        <span class="skeleton-bar w-16 h-5 rounded-full"></span>
      </div>
      <div class="grid grid-cols-2 gap-2">
        <span class="skeleton-bar w-full h-12 rounded-lg"></span>
        <span class="skeleton-bar w-full h-12 rounded-lg"></span>
        <span class="skeleton-bar w-full h-12 rounded-lg"></span>
        <span class="skeleton-bar w-full h-12 rounded-lg"></span>
      </div>
    </div>
    <div class="card-signal skeleton-card hidden lg:block" data-signals-skeleton>
      <div class="flex items-center justify-between mb-3">
        <div class="flex items-center gap-2">
          <span class="skeleton-bar w-8 h-8 rounded-full"></span>
          <span class="skeleton-bar w-20 h-4"></span>
        </div>
        <span class="skeleton-bar w-16 h-5 rounded-full"></span>
      </div>
      <div class="grid grid-cols-2 gap-2">
        <span class="skeleton-bar w-full h-12 rounded-lg"></span>
        <span class="skeleton-bar w-full h-12 rounded-lg"></span>
        <span class="skeleton-bar w-full h-12 rounded-lg"></span>
        <span class="skeleton-bar w-full h-12 rounded-lg"></span>
      </div>
    </div>
  </div>
</section>

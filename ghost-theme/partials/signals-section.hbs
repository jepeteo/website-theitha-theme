<section data-partial="signals-section" class="flex flex-col gap-4">
  {{!-- Summary stats bar --}}
  <div data-signals-summary class="card-muted p-4 rounded-lg">
    {{!-- Skeleton placeholder while loading --}}
    <div class="grid grid-cols-3 gap-4 text-center" data-signals-skeleton>
      <div class="flex flex-col gap-2 items-center">
        <span class="skeleton-bar w-10 h-5"></span>
        <span class="text-caption">Active</span>
      </div>
      <div class="flex flex-col gap-2 items-center">
        <span class="skeleton-bar w-10 h-5"></span>
        <span class="text-caption">Winners</span>
      </div>
      <div class="flex flex-col gap-2 items-center">
        <span class="skeleton-bar w-10 h-5"></span>
        <span class="text-caption">Total</span>
      </div>
    </div>
  </div>

  {{!-- Signal cards grid with skeleton placeholders --}}
  <div data-signals-list class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
    <div class="card-signal skeleton-card" data-signals-skeleton>
      <div class="flex items-center justify-between mb-3">
        <span class="skeleton-bar w-20 h-4"></span>
        <span class="skeleton-bar w-12 h-4 rounded-full"></span>
      </div>
      <div class="grid grid-cols-2 gap-2">
        <span class="skeleton-bar w-full h-3"></span>
        <span class="skeleton-bar w-full h-3"></span>
        <span class="skeleton-bar w-full h-3"></span>
        <span class="skeleton-bar w-full h-3"></span>
      </div>
    </div>
    <div class="card-signal skeleton-card hidden md:block" data-signals-skeleton>
      <div class="flex items-center justify-between mb-3">
        <span class="skeleton-bar w-20 h-4"></span>
        <span class="skeleton-bar w-12 h-4 rounded-full"></span>
      </div>
      <div class="grid grid-cols-2 gap-2">
        <span class="skeleton-bar w-full h-3"></span>
        <span class="skeleton-bar w-full h-3"></span>
        <span class="skeleton-bar w-full h-3"></span>
        <span class="skeleton-bar w-full h-3"></span>
      </div>
    </div>
    <div class="card-signal skeleton-card hidden lg:block" data-signals-skeleton>
      <div class="flex items-center justify-between mb-3">
        <span class="skeleton-bar w-20 h-4"></span>
        <span class="skeleton-bar w-12 h-4 rounded-full"></span>
      </div>
      <div class="grid grid-cols-2 gap-2">
        <span class="skeleton-bar w-full h-3"></span>
        <span class="skeleton-bar w-full h-3"></span>
        <span class="skeleton-bar w-full h-3"></span>
        <span class="skeleton-bar w-full h-3"></span>
      </div>
    </div>
  </div>
</section>

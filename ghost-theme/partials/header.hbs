<header data-partial="header" class="sticky top-0 z-50 bg-bg/95 backdrop-blur-sm border-b border-border">
  {{!-- Row 1: Logo + Navigation --}}
  <div class="container flex items-center justify-between py-3">
    <a href="{{@site.url}}" class="flex items-center gap-2 no-underline" aria-label="{{@site.title}} Home">
      {{#if @site.logo}}
        <img src="{{@site.logo}}" alt="{{@site.title}}" class="h-8 w-auto" />
      {{else}}
        <span class="font-heading text-lg font-bold text-text tracking-tight">{{@site.title}}</span>
      {{/if}}
    </a>

    <div class="hidden md:flex items-center gap-2">
      <nav class="flex items-center gap-1" aria-label="Main navigation">
        <a href="/" class="nav-link">Home</a>
        <a href="/markets/" class="nav-link">Markets</a>
        <a href="/signals/" class="nav-link">Signals</a>
        <a href="/blog/" class="nav-link">Blog</a>
        <a href="#/portal/signup" data-portal="signup" class="nav-link">Subscribe</a>

        <div class="relative group">
          <span class="nav-link inline-flex items-center gap-1 cursor-default" tabindex="0" role="button" aria-haspopup="true" aria-expanded="false">
            Links
            <svg class="w-3 h-3 text-muted group-hover:text-text transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </span>
          <div class="absolute left-0 top-full w-48 hidden group-hover:block group-focus-within:block z-[60] pt-2">
            <div class="bg-surface border border-border rounded-lg shadow-lg p-1">
              <a href="https://christosmentis.substack.com/" target="_blank" rel="noopener noreferrer" class="nav-link block">Substack</a>
              <a href="https://www.amazon.com/dp/B0GLF3H5FV" target="_blank" rel="noopener noreferrer" class="nav-link block">Forex Blueprint Series</a>
            </div>
          </div>
        </div>
      </nav>

      {{#if @member}}
        <a href="#/portal/account" data-portal="account" class="btn-outline text-xs px-3 py-1.5">Account</a>
      {{else}}
        <a href="#/portal/signin" data-portal="signin" class="btn-outline text-xs px-3 py-1.5">Login</a>
      {{/if}}
    </div>

    {{!-- Mobile menu button --}}
    <button
      class="md:hidden p-2 border-0 bg-transparent"
      aria-label="Toggle navigation"
      onclick="document.getElementById('mobile-nav').classList.toggle('hidden')"
    >
      <svg class="w-5 h-5 text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>

  {{!-- Mobile nav dropdown --}}
  <nav id="mobile-nav" class="hidden md:hidden border-t border-border" aria-label="Mobile navigation">
    <div class="container py-3 flex flex-col gap-1">
      <a href="/" class="nav-link">Home</a>
      <a href="/markets/" class="nav-link">Markets</a>
      <a href="/signals/" class="nav-link">Signals</a>
      <a href="/blog/" class="nav-link">Blog</a>
      <a href="#/portal/signup" data-portal="signup" class="nav-link">Subscribe</a>

      <div class="px-3 pt-2 pb-1 text-caption text-xs uppercase tracking-wide">Links</div>
      <a href="https://christosmentis.substack.com/" target="_blank" rel="noopener noreferrer" class="nav-link pl-5">Substack</a>
      <a href="https://www.amazon.com/dp/B0GLF3H5FV" target="_blank" rel="noopener noreferrer" class="nav-link pl-5">Forex Blueprint Series</a>

      <div class="pt-2">
        {{#if @member}}
          <a href="#/portal/account" data-portal="account" class="btn-outline text-xs px-3 py-1.5">Account</a>
        {{else}}
          <a href="#/portal/signin" data-portal="signin" class="btn-outline text-xs px-3 py-1.5">Login</a>
        {{/if}}
      </div>
    </div>
  </nav>

  {{!-- Row 2: Ticker tape full width --}}
  <div data-container="header-ticker" class="border-t border-border bg-surface">
    <div id="tv-ticker"></div>
  </div>
</header>
